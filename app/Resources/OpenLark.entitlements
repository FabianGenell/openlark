<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required by hardened-runtime + TCC to even prompt for microphone access. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Allow JIT (MLX/Swift concurrency may need this in some configurations). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory, needed for some Swift runtime paths. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading dylibs the OS recognizes. We don't have any unsigned dylibs
         but this future-proofs against KeyboardShortcuts/etc adding any. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
